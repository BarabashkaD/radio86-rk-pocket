diff --git a/fpga/rtl/pocket_cart_ppi.v b/fpga/rtl/pocket_cart_ppi.v
index 268188e..5b120b8 100644
--- a/fpga/rtl/pocket_cart_ppi.v
+++ b/fpga/rtl/pocket_cart_ppi.v
@@ -43,10 +43,12 @@ wire [7:0] pb_pin = pb_oe ? pb_o : 8'hFF;
 wire [7:0] pc_pin = (pc_oe & pc_o) | ~pc_oe;
 reg [6:0] bank = 7'd0;
 reg pc7_q = 1'b1;                       // the PC7 pin, one clk back
+reg [7:0] pc_q = 8'hFF;
 always @(posedge clk) begin
     pc7_q <= pc_pin[7];
+    pc_q <= pc_pin;
     if (card_reset) bank <= 7'd0;
-    else if (card && pc7_q && pc_pin == 8'h7F) bank <= pb_pin[6:0];   // PC7 fell, PC0-PC6 high
+    else if (card && pc_q == 8'hFF && pc_pin == 8'h7F) bank <= pb_pin[6:0];   // PC7 fell, PC0-PC6 high
 end
 assign rom_address = {card ? bank : 7'd0, wide & pc_pin[7], pc_pin[6:0], pb_pin};
 wire [7:0] pa_pin = loaded ? rom_data : 8'hFF;
